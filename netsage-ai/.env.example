# AI_PROVIDER selects which AI backend to use.
# Default is "ollama" — works locally with no paid API required.
# Allowed values: ollama | gemini | anthropic | openrouter
AI_PROVIDER=ollama

# --- Ollama (local/free, default) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Gemini (Google AI Studio) ---
# Uncomment and fill in if AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# --- Anthropic (Claude) ---
# Uncomment and fill in if AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- OpenRouter ---
# Uncomment and fill in if AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct
